{
  "task_description": "{'component_name': 'Main Container for ReviseMate', 'description': 'Primary container for ReviseMate implementation: Reviser is a frontend-only web app that helps students revise for exams by letting them upload PDF or Word files, extract study material directly in the browser, and generate multiple-choice questions (MCQs) using an external LLM API (like OpenAI GPT). All processing is client-side, with a clean, student-friendly UI and no backend required.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "File Upload (.pdf, .docx)",\n      "description": "Users can upload PDF and Word (.docx) files via a browser file input. No backend is involved; all uploads are processed in-browser.",\n      "isEnabled": true\n    },\n    {\n      "name": "Text Extraction (Client-side)",\n      "description": "Extracts text from uploaded files using pdfjs-dist for PDFs and mammoth.js for Word documents, all in the browser.",\n      "isEnabled": true\n    },\n    {\n      "name": "MCQ Generation via API",\n      "description": "Uses an external LLM API (e.g., OpenAI GPT-4) to generate MCQs from the extracted text. Users can paste their own API key or get guidance to set one securely in the frontend.",\n      "isEnabled": true\n    },\n    {\n      "name": "Interactive Quiz Interface",\n      "description": "Displays generated MCQs in a responsive, clean quiz format. Users can select answers, view correct ones, and get optional feedback.",\n      "isEnabled": true\n    },\n    {\n      "name": "Mobile Responsive & Minimalist UI",\n      "description": "Modern, student-friendly, and mobile-responsive design with clear buttons for Upload, Generate MCQs, and Practice. No login or backend required.",\n      "isEnabled": true\n    },\n    {\n      "name": "Offline Capability (where possible)",\n      "description": "App is optimized for offline use where feasible (e.g., static assets, service worker for caching).",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#000000",\n    "secondary": "#f1f5f9",\n    "accent": "#fbbf24"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a centered card or panel with the \'Reviser\' title at the top. Below are clear buttons for uploading files, generating MCQs, and starting practice. The quiz interface displays one question at a time with answer options and feedback. The layout is minimalist, with ample whitespace, large touch-friendly buttons, and adapts gracefully to mobile screens."\n}'}",
